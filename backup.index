<script lang="ts" setup>
import { ProductsOrderByEnum } from '#gql/default';
import type { Product } from '#types/gql';

const { siteName, description, shortDescription, siteImage } = useAppConfig();

const { data } = await useAsyncGql('getProductCategories', { first: 12 });
const productCategories = data.value?.productCategories?.nodes || [];

const { data: newInData } = await useAsyncGql('getNewInProducts', { 
  category: 'gadgets' 
});

const newInProducts = computed<Product[]>(() => 
  (newInData.value?.products?.nodes as Product[] | undefined) ?? []
);

const { data: productData } = await useAsyncGql('getProducts', { first: 10, orderby: ProductsOrderByEnum.Popularity });
const popularProducts = productData.value?.products?.nodes || [];

useSeoMeta({
  title: `Home`,
  ogTitle: siteName,
  description: description,
  ogDescription: shortDescription,
  ogImage: siteImage,
  twitterCard: `summary_large_image`,
});

const validCategories = computed(() =>
  productCategories.filter((cat): cat is typeof cat & { slug: string } => !!cat.slug)
);

const categorySliderRef = ref<HTMLElement | null>(null);
const newInSliderRef = ref<HTMLElement | null>(null);
const scrollNewIn = (direction: 'left' | 'right') => {
  if (!newInSliderRef.value) return;
  const scrollAmount = newInSliderRef.value.clientWidth * 0.8;
  newInSliderRef.value.scrollBy({
    left: direction === 'left' ? -scrollAmount : scrollAmount,
    behavior: 'smooth',
  });
};
</script>

