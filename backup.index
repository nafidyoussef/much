<script lang="ts" setup>
import { ProductsOrderByEnum } from '#gql/default';
import type { Product } from '#types/gql';

const { siteName, description, shortDescription, siteImage } = useAppConfig();

// 1. Récupération des données
const { data: newInData } = await useAsyncGql('getNewInProducts', { 
  category: 'new' 
});
const newInProducts = computed<Product[]>(() => 
  (newInData.value?.products?.nodes as Product[] | undefined) ?? []
);

const { data: productData } = await useAsyncGql('getProducts', { first: 20, orderby: ProductsOrderByEnum.Popularity });
const popularProducts = (productData.value?.products?.nodes as Product[]) || [];

// 2. Logique des onglets de catégories pour la section "Recommandé pour vous"
const categories = [
  { slug: 'all', name: 'Tout' },
  { slug: 'maison', name: 'Maison' },
  { slug: 'cuisine', name: 'Cuisine' },
  { slug: 'tech', name: 'Tech' },
  { slug: 'beaute', name: 'Beauté' },
  { slug: 'mode', name: 'Mode' },
  { slug: 'auto', name: 'Auto' },
  { slug: 'kids', name: 'Kids' },
  { slug: 'sport', name: 'Sport' },
];

const activeCategory = ref('all');

const selectCategory = (slug: string) => {
  activeCategory.value = slug;
};

// Filtrage dynamique des produits selon la catégorie active
const filteredProducts = computed(() => {
  if (activeCategory.value === 'all') {
    return popularProducts;
  }
  return popularProducts.filter((product: any) => 
    product.categories?.nodes?.some((cat: any) => cat.slug === activeCategory.value) ||
    product.productCategories?.nodes?.some((cat: any) => cat.slug === activeCategory.value)
  );
});

useSeoMeta({
  title: `Home`,
  ogTitle: siteName,
  description: description,
  ogDescription: shortDescription,
  ogImage: siteImage,
  twitterCard: `summary_large_image`,
});

// 3. Logique du slider
const newInSliderRef = ref<HTMLElement | null>(null);
const scrollNewIn = (direction: 'left' | 'right') => {
  if (!newInSliderRef.value) return;
  const scrollAmount = newInSliderRef.value.clientWidth * 0.8;
  newInSliderRef.value.scrollBy({
    left: direction === 'left' ? -scrollAmount : scrollAmount,
    behavior: 'smooth',
  });
};

//------------


</script>

